<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox spacing="25" styleClass="consultation-form-container" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arklok.nutra.controllers.ConsultationController">
    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button onAction="#goBack" styleClass="back-button" text="← Volver" />
        <Text styleClass="consultation-title" text="Nueva Consulta" />
    </HBox>

    <!-- Form Content in ScrollPane -->
    <ScrollPane fitToWidth="true" styleClass="consultation-scroll" VBox.vgrow="ALWAYS">
        <VBox spacing="20">
            <padding>
                <Insets bottom="20" left="10" right="10" top="10" />
            </padding>

            <!-- Patient Information Section -->
            <VBox spacing="15" styleClass="form-section">
                <Text styleClass="section-subtitle" text="Información del Paciente" />

                <VBox spacing="8">
                    <Label styleClass="form-label" text="Paciente" />
                    <ComboBox fx:id="patientComboBox" prefWidth="Infinity" promptText="Seleccionar paciente..." styleClass="form-control" />
                </VBox>

                <VBox spacing="8">
                    <Label styleClass="form-label" text="Fecha y Hora de la Consulta" />
                    <DatePicker fx:id="consultationDatePicker" prefWidth="Infinity" promptText="dd/mm/aaaa" styleClass="form-control" />
                </VBox>
            </VBox>

            <!-- Measurements Section -->
            <VBox spacing="15" styleClass="form-section">
                <Text styleClass="section-subtitle" text="Mediciones" />

                <VBox spacing="8">
                    <Label styleClass="form-label" text="Peso (kg)" />
                    <TextField fx:id="weightField" promptText="0.0" styleClass="form-control" />
                </VBox>
            </VBox>

            <!-- Notes Section -->
            <VBox spacing="15" styleClass="form-section">
                <Text styleClass="section-subtitle" text="Observaciones" />

                <VBox spacing="8">
                    <Label styleClass="form-label" text="Motivo de Consulta" />
                    <TextArea fx:id="reasonArea" prefRowCount="3" promptText="Describe el motivo de la consulta..." styleClass="form-control-area" wrapText="true" />
                </VBox>

                <VBox spacing="8">
                    <Label styleClass="form-label" text="Notas Adicionales" />
                    <TextArea fx:id="notesArea" prefRowCount="5" promptText="Añade cualquier observación relevante..." styleClass="form-control-area" wrapText="true" />
                </VBox>
            </VBox>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="20">
                <padding>
                    <Insets top="20" />
                </padding>

                <Button onAction="#cancelConsultation" styleClass="cancel-button" text="Cancelar" />
                <Button onAction="#saveConsultation" styleClass="save-button" text="Guardar Consulta" />
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>

