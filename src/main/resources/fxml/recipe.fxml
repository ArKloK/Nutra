<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="926.0" prefWidth="1465.0" spacing="25" styleClass="consultation-form-container" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arklok.nutra.controllers.RecipeController">
    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button onAction="#goBack" styleClass="back-button" text="← Volver" />
        <Text styleClass="consultation-title" text="Nueva Receta" />
    </HBox>

    <!-- Form Content in ScrollPane -->
    <ScrollPane fitToWidth="true" styleClass="consultation-scroll" VBox.vgrow="ALWAYS">
        <VBox spacing="20">
            <padding>
                <Insets bottom="20" left="10" right="10" top="10" />
            </padding>

            <!-- Basic Information Section -->
            <VBox spacing="15" styleClass="form-section">
                <Text styleClass="section-subtitle" text="Información Básica" />

                <VBox spacing="8">
                    <Label styleClass="form-label" text="Título*" />
                    <TextField fx:id="titleField" promptText="Nombre de la receta" styleClass="form-control" />
                </VBox>

                <VBox spacing="8">
                    <Label styleClass="form-label" text="Descripción" />
                    <TextArea fx:id="descriptionArea" prefRowCount="3" promptText="Breve descripción de la receta..." styleClass="form-control-area" wrapText="true" />
                </VBox>

                <VBox spacing="8">
                    <Label styleClass="form-label" text="Tiempo de Preparación (minutos)" />
                    <TextField fx:id="timeField" promptText="0" styleClass="form-control" />
                </VBox>
            </VBox>

            <!-- Ingredients Section -->
            <VBox spacing="15" styleClass="form-section">
                <Text styleClass="section-subtitle" text="Ingredientes" />

                <!-- Add Ingredient Controls -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label styleClass="form-label" text="Seleccionar Ingrediente:" />
                    <ComboBox fx:id="ingredientComboBox" promptText="Elegir ingrediente..." styleClass="form-control" HBox.hgrow="ALWAYS" />
                    <Button onAction="#createNewIngredient" styleClass="secondary-button" text="+" minWidth="40" minHeight="40" />
                    <Button onAction="#addSelectedIngredient" styleClass="save-button" text="Añadir" />
                </HBox>

                <!-- Ingredients Table -->
                <TableView fx:id="ingredientsTable" styleClass="ingredients-table">
                    <columns>
                        <TableColumn fx:id="ingredientNameColumn" text="Ingrediente" />
                        <TableColumn fx:id="amountColumn" text="Cantidad" />
                        <TableColumn fx:id="unitColumn" text="Unidad" />
                        <TableColumn fx:id="notesColumn" text="Notas" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Instructions Section -->
            <VBox spacing="15" styleClass="form-section">
                <Text styleClass="section-subtitle" text="Instrucciones de Preparación" />

                <VBox spacing="8">
                    <Label styleClass="form-label" text="Pasos de Preparación*" />
                    <TextArea fx:id="instructionsArea" prefRowCount="8" promptText="Describe paso a paso cómo preparar la receta..." styleClass="form-control-area" wrapText="true" />
                </VBox>
            </VBox>

            <!-- Additional Notes Section -->
            <VBox spacing="15" styleClass="form-section">
                <Text styleClass="section-subtitle" text="Notas Adicionales" />

                <VBox spacing="8">
                    <Label styleClass="form-label" text="Notas" />
                    <TextArea fx:id="notesArea" prefRowCount="4" promptText="Añade cualquier nota relevante sobre la receta..." styleClass="form-control-area" wrapText="true" />
                </VBox>
            </VBox>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="20">
                <padding>
                    <Insets top="20" />
                </padding>

                <Button onAction="#cancelRecipe" styleClass="cancel-button" text="Cancelar" />
                <Button onAction="#saveRecipe" styleClass="save-button" text="Guardar Receta" />
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>

