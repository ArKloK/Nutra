<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="926.0" prefWidth="1465.0" spacing="25" styleClass="consultation-form-container" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arklok.nutra.controllers.RecipeDetailController">
    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button onAction="#goBack" styleClass="back-button" text="← Volver" />
        <Text fx:id="titleText" styleClass="consultation-title" text="Receta" />
        <HBox HBox.hgrow="ALWAYS" />
        <Button onAction="#editRecipe" styleClass="save-button" text="Editar Receta" />
    </HBox>

    <!-- Content in ScrollPane -->
    <ScrollPane fitToWidth="true" styleClass="consultation-scroll" VBox.vgrow="ALWAYS">
        <VBox spacing="25">
            <padding>
                <Insets bottom="20" left="10" right="10" top="10" />
            </padding>

            <!-- Description Section -->
            <VBox fx:id="descriptionSection" spacing="10" styleClass="form-section">
                <Text styleClass="section-subtitle" text="Descripción" />
                <Text fx:id="descriptionText" styleClass="detail-text" wrappingWidth="1300" />
            </VBox>

            <!-- Basic Info Section -->
            <VBox spacing="15" styleClass="form-section">
                <Text styleClass="section-subtitle" text="Información General" />

                <HBox spacing="20">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Text styleClass="form-label" text="Tiempo de Preparación" />
                        <Text fx:id="timeText" styleClass="detail-text" text="-" />
                    </VBox>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Text styleClass="form-label" text="Número de Ingredientes" />
                        <Text fx:id="ingredientCountText" styleClass="detail-text" text="-" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Ingredients Section -->
            <VBox spacing="15" styleClass="form-section">
                <Text styleClass="section-subtitle" text="Ingredientes" />
                <VBox fx:id="ingredientsContainer" spacing="8" />
            </VBox>

            <!-- Instructions Section -->
            <VBox spacing="15" styleClass="form-section">
                <Text styleClass="section-subtitle" text="Instrucciones de Preparación" />
                <Text fx:id="instructionsText" styleClass="detail-text" wrappingWidth="1300" />
            </VBox>

            <!-- Notes Section -->
            <VBox fx:id="notesSection" spacing="15" styleClass="form-section">
                <Text styleClass="section-subtitle" text="Notas Adicionales" />
                <Text fx:id="notesText" styleClass="detail-text" wrappingWidth="1300" />
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>

