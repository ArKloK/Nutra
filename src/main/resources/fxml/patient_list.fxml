<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="926.0" prefWidth="1465.0" spacing="25" styleClass="consultation-form-container" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arklok.nutra.controllers.PatientListController">
    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button onAction="#goBack" styleClass="back-button" text="← Volver" />
        <Text styleClass="consultation-title" text="Pacientes" />
        <HBox HBox.hgrow="ALWAYS" />
        <Button onAction="#showNewPatient" styleClass="save-button" text="+ Nuevo Paciente" />
    </HBox>

    <!-- Search Filter -->
    <VBox spacing="10">
        <Text styleClass="form-label" text="Buscar por nombre" />
        <TextField fx:id="searchField" promptText="Escribe el nombre o apellido del paciente..." styleClass="form-control" />
    </VBox>

    <!-- Patient List in ScrollPane -->
    <ScrollPane fitToWidth="true" styleClass="consultation-scroll" VBox.vgrow="ALWAYS">
        <VBox fx:id="patientListContainer" spacing="15">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
        </VBox>
    </ScrollPane>
</VBox>

